        "status": 422
      }
    },
    {
      "description": "GET /verify/{submission_id} returns accepted status",
      "request": {
        "method": "GET",
        "path": "/verify/gazette-sub-abc123"
      },
      "response": {
        "status": 200,
        "body": {
          "submission_id": "gazette-sub-abc123",
          "status": "accepted"
        }
      }
    }
  ],
  "metadata": {
