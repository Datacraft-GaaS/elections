          "artifact_id": "01900000-0000-7000-8000-000000000001",
          "subscription_id": "01900000-0000-7000-8000-000000000002",
          "format": "pdf",
          "sha256": "a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "submission_id": "gazette-sub-abc123",
          "submitted_at": "2026-01-01T00:00:00Z"
        }
      }
    },
    {
      "description": "POST /deliver/gov-printer with missing fields returns 422",
      "request": {
        "method": "POST",
