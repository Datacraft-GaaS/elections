FROM rust:1.83-slim AS builder
WORKDIR /build
COPY eel-adapter-telco-vpn-rs/ eel-adapter-telco-vpn-rs/
WORKDIR /build/eel-adapter-telco-vpn-rs
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y strongswan-swanctl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/eel-adapter-telco-vpn-rs/target/release/eel-adapter-telco-vpn /usr/local/bin/
CMD ["eel-adapter-telco-vpn"]
