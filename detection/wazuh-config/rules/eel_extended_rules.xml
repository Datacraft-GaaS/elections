    <mitre><id>T1565.001</id></mitre>
  </rule>
  <rule id="100115" level="14">
    <decoded_as>eel-audit-decoder</decoded_as>
    <field name="eventType">signature_verify</field>
    <field name="SignatureStatus">invalid</field>
    <description>EEL: Ed25519 signature verification failed</description>
  </rule>
  <rule id="100116" level="14">
    <decoded_as>falco-decoder</decoded_as>
    <field name="rule">Audit log symlink created over audit directory</field>
    <description>EEL: Symlink attack on audit directory</description>
  </rule>
  <rule id="100117" level="14">
    <decoded_as>falco-decoder</decoded_as>
    <field name="rule">Audit replay script executed</field>
    <description>EEL: Audit replay script executed</description>
  </rule>

