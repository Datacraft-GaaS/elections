<!--
  Wazuh extended rules for EEL — M5 hardening extended.
  References: ADR 0004, 0006, 0009, 0010, 0019, 0022, 0023
  Sources: audit_service, falco, tetragon, biometric_capture, iprs_client,
           supply_chain, mdm_policy, network, form_service
  Rules 100110-101013 (aligned with sigma rules).
-->
<group name="eel_extended">

  <!-- AUDIT REPLAY / INTEGRITY — 100110-100119 -->
  <rule id="100110" level="14">
    <decoded_as>falco-decoder</decoded_as>
    <field name="rule">Biometric audit log deleted or truncated</field>
    <description>EEL: Audit log tampered</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>
  <rule id="100111" level="14">
    <decoded_as>falco-decoder</decoded_as>
    <field name="rule">Audit shadow file opened for reconstruction</field>
    <description>EEL: Audit shadow reconstruction attempt</description>
  </rule>
  <rule id="100112" level="14">
    <decoded_as>eel-audit-decoder</decoded_as>
    <field name="eventType">audit_replay</field>
    <description>EEL: Audit event replay — same auditId used again</description>
    <mitre><id>T1070.001</id></mitre>
  </rule>
  <rule id="100113" level="14">
    <decoded_as>eel-audit-decoder</decoded_as>
    <field name="eventType">audit_shadow_rebuild</field>
    <description>EEL: Audit shadow rebuild attempted</description>
  </rule>
  <rule id="100114" level="14">
    <decoded_as>eel-audit-decoder</decoded_as>
    <field name="eventType">audit_integrity_check</field>
    <field name="ProofHashStatus">mismatch</field>
