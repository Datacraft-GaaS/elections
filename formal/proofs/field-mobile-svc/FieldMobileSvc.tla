EXTENDS Naturals, FiniteSets, Sequences, TLC
CONSTANTS NULL
CONSTANTS FAILS, MEETS, UNVERIFIED, attestations, form_submissions, idempotency_keys, quality_gate_passed, rejected_reasons
VARIABLES state
Inv1 == \A req_1 \in form_submissions : req_1.quality_gate_passed = TRUE => req_1.accepted = TRUE
Inv2 == \A req_2 \in form_submissions : req_2.quality_gate_passed = FALSE => req_2.rejected = TRUE
Inv3 == Len(rejected_reasons) >= 1 => quality_gate_passed = FALSE
Inv4 == \A req_4 \in form_submissions : req_4.station_code /= NULL
Inv5 == Len(idempotency_keys) >= 1 => \A k_5 \in idempotency_keys : \A x_5 \in idempotency_keys : k_5 = x_5 => k_5.responses = x_5.responses
Inv6 == \A app_6 \in attestations : app_6.verdict \in {"MEETS", "FAILS", "UNVERIFIED"}

