---
// BVV Portal landing page -- static shell wrapping the LiveView app.
// Jump-off to the voter lookup and objections LiveView.
const liveViewUrl = import.meta.env.LIVEVIEW_URL || 'http://localhost:4000';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>BVV - Voter Register Verification</title>
  <meta name="description" content="the Commission voter register public inspection portal." />
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f5f5f5; }
    .hero { background: #006600; color: white; padding: 3rem 2rem; text-align: center; }
    .hero h1 { margin: 0 0 1rem; font-size: 2rem; }
    .actions { display: flex; gap: 1rem; justify-content: center; margin-top: 2rem; flex-wrap: wrap; }
    .btn { padding: 0.8rem 2rem; border-radius: 4px; text-decoration: none; font-weight: 600; }
    .btn-primary { background: white; color: #006600; }
    .btn-secondary { background: transparent; color: white; border: 2px solid white; }
  </style>
</head>
<body>
  <div class="hero">
    <h1>Voter Register Verification</h1>
    <p>Confirm your voter registration details during the 30-day public inspection window.</p>
    <div class="actions">
      <a href={`${liveViewUrl}/lookup`} class="btn btn-primary">Look Up My Registration</a>
      <a href={`${liveViewUrl}/objections/new`} class="btn btn-secondary">File an Objection</a>
    </div>
  </div>
</body>
</html>
