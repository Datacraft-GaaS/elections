<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Security-Policy"
        content="default-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; script-src 'none'" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }} — ABIS Report</title>
  <style>
    /* Minimal WCAG AA compliant base styles — no external assets */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      font-size: 1rem;
      line-height: 1.5;
      color: #111;
      background: #fff;
      padding: 2rem;
    }
    .skip-link {
      position: absolute;
      left: -999px;
      top: 0;
      background: #005fcc;
      color: #fff;
      padding: 0.5rem 1rem;
      text-decoration: none;
    }
    .skip-link:focus { left: 0; }
    header { margin-bottom: 1.5rem; border-bottom: 2px solid #005fcc; padding-bottom: 0.75rem; }
    h1 { font-size: 1.5rem; color: #003380; }
    .meta { font-size: 0.85rem; color: #555; margin-top: 0.25rem; }
    main { margin-bottom: 2rem; }
    section { overflow-x: auto; }
    table {
      border-collapse: collapse;
      width: 100%;
      font-size: 0.875rem;
      min-width: 600px;
    }
    th, td { border: 1px solid #ccc; padding: 0.4rem 0.6rem; text-align: left; }
    th { background: #e8edf5; font-weight: 600; }
    tr:nth-child(even) { background: #f7f9fc; }
    tr:hover { background: #eef2fa; }
    a:focus, button:focus, [tabindex]:focus { outline: 3px solid #005fcc; outline-offset: 2px; }
    .chart { margin: 1.5rem 0; max-width: 100%; overflow-x: auto; }
    footer { font-size: 0.8rem; color: #777; border-top: 1px solid #ddd; padding-top: 0.5rem; }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {% block header %}
  <header role="banner">
    <h1>{{ title }}</h1>
    <div class="meta">
      Window: {{ window_from | truncate(length=10, end="") }} to {{ window_to | truncate(length=10, end="") }}
      | Rows: {{ row_count }}
      | Generated: {{ generated_at }}
      | Version: {{ template_version }}
    </div>
  </header>
  {% endblock header %}

  <main id="main-content" role="main">
    {% block chart %}
    {% if chart_svg %}
    <div class="chart" aria-label="Report chart">
      {{ chart_svg | safe }}
    </div>
    {% endif %}
    {% endblock chart %}

    {% block content %}
    <section aria-label="Report data table">
      {% include "partials/table.html.tera" %}
    </section>
    {% endblock content %}
  </main>

  {% block footer %}
  <footer role="contentinfo">
    <small>
      Slug: {{ slug }} | Template: {{ template_version }} | EEL ABIS Reports Engine
    </small>
  </footer>
  {% endblock footer %}
</body>
</html>
