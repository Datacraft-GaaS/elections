---
// Constituency results view (FR-M11-002).
// [code] is the IEBC constituency code, e.g. 001 for Garissa Township.
// Pre-rendered statically from signed tarball at build time.

export async function getStaticPaths() {
  // In production: load constituency list from signed tarball via eel-web-astro loader.
  // Stub: return empty so cargo/astro build passes without real data.
  return []
}

const { code } = Astro.params
const locale = Astro.currentLocale ?? 'en'
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Constituency {code} Results | eel</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <header><nav><a href="/">Home</a></nav></header>
    <main id="main" tabindex="-1">
      <h1>Constituency <code>{code}</code> Results</h1>
      <p>Results for this constituency will appear once published.</p>
      <p><a href="/transparency">View transparency log</a></p>
    </main>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 960px; margin: 0 auto; padding: 1rem; }
      .skip-link { position: absolute; left: -9999px; }
      .skip-link:focus { left: 0; background: #000; color: #fff; padding: .5rem 1rem; z-index: 100; }
    </style>
  </body>
</html>
