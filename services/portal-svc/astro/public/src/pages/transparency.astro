---
// Transparency log viewer: inclusion + consistency proofs via WASM verifier-rs
// (FR-M11-006, FR-M11-011, AC-M11-02).
// WASM bundle is self-hosted (no external JS, per ADR-0008).

const locale = Astro.currentLocale ?? 'en'
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <title>Transparency Log | eel</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <header role="banner">
      <nav aria-label="Primary navigation">
        <a href="/">Results</a>
        <a href="/transparency" aria-current="page">Transparency Log</a>
        <a href="/history">Snapshots</a>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <h1>Transparency Log</h1>

      <section aria-labelledby="h-sth">
        <h2 id="h-sth">Current Signed Tree Head</h2>
        <p>Fetch the latest STH from the transparency log API and verify it below.</p>
        <div id="sth-display" aria-live="polite" aria-label="Signed tree head">
          <p>Loading...</p>
        </div>
      </section>

      <section aria-labelledby="h-inclusion">
        <h2 id="h-inclusion">Inclusion Proof</h2>
        <form id="inclusion-form" aria-label="Verify inclusion proof">
          <label for="leaf-hash">Leaf hash (hex)</label>
          <input id="leaf-hash" name="leaf_hash" type="text" pattern="[0-9a-fA-F]{64}"
            placeholder="64 hex characters" required autocomplete="off" />
          <button type="submit">Verify</button>
        </form>
        <div id="inclusion-result" aria-live="polite" aria-label="Inclusion proof result"></div>
      </section>

      <section aria-labelledby="h-consistency">
        <h2 id="h-consistency">Consistency Proof</h2>
        <form id="consistency-form" aria-label="Verify consistency proof">
          <label for="from-size">From tree size</label>
          <input id="from-size" name="from_size" type="number" min="1" required />
          <label for="to-size">To tree size</label>
          <input id="to-size" name="to_size" type="number" min="1" required />
          <button type="submit">Verify</button>
        </form>
        <div id="consistency-result" aria-live="polite" aria-label="Consistency proof result"></div>
      </section>
    </main>

    <!--
      verifier-rs WASM loaded from self-hosted path.
      No external scripts (ADR-0008, FR-M11-024).
      Edge nonce injected into the script tag at request time.
    -->
    <script type="module" nonce="EDGE_NONCE">
      // WASM verifier-rs integration placeholder.
      // Production: import init, { verify_inclusion, verify_consistency } from '/wasm/verifier_rs.js';
      const API_BASE = '/api/v1/portal'

      async function loadSTH() {
        try {
          const r = await fetch(`${API_BASE}/snapshots/latest`)
          if (!r.ok) throw new Error(`HTTP ${r.status}`)
          const snap = await r.json()
          document.getElementById('sth-display').innerHTML =
            `<dl>
               <dt>Merkle root</dt><dd><code>${snap.merkle_root}</code></dd>
               <dt>Published</dt><dd><time>${snap.published_at}</time></dd>
               <dt>Snapshot ID</dt><dd><code>${snap.snapshot_id}</code></dd>
             </dl>`
        } catch (e) {
          document.getElementById('sth-display').textContent = `Error: ${e.message}`
        }
      }

      document.getElementById('inclusion-form').addEventListener('submit', async (ev) => {
        ev.preventDefault()
        const leafHash = document.getElementById('leaf-hash').value
        const el = document.getElementById('inclusion-result')
        el.textContent = 'Verifying...'
        try {
          const r = await fetch(`${API_BASE}/snapshots/00000000-0000-0000-0000-000000000000/verify`)
          if (!r.ok) throw new Error(`HTTP ${r.status}`)
          const proof = await r.json()
          // Production: const ok = verify_inclusion(leafHash, proof.siblings, proof.root)
          el.innerHTML = `<p><strong aria-label="status">${proof.verified ? 'Verified' : 'Unverified'}</strong>: root = <code>${proof.root}</code></p>`
        } catch (e) {
          el.textContent = `Error: ${e.message}`
        }
      })

      loadSTH()
    </script>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: system-ui, sans-serif; max-width: 960px; margin: 0 auto; padding: 1rem; }
      .skip-link { position: absolute; left: -9999px; }
      .skip-link:focus { left: 0; background: #000; color: #fff; padding: .5rem 1rem; z-index: 100; }
      nav a { margin-right: 1rem; }
      section { margin: 2rem 0; }
      form { display: flex; flex-direction: column; gap: .5rem; max-width: 480px; }
      input, button { font-size: 1rem; padding: .4rem .6rem; }
      code { font-family: monospace; word-break: break-all; }
      dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1rem; }
    </style>
  </body>
</html>
