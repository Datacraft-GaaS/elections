<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>EEL Queue Map</title>
    <style>
      body { font-family: sans-serif; margin: 0; padding: 1rem; background: #f5f5f5; }
      .eel-queue-map h1 { font-size: 1.5rem; margin-bottom: 1rem; }
      .station-list { display: flex; flex-wrap: wrap; gap: 1rem; }
      .station-card { background: white; border-radius: 8px; padding: 1rem; min-width: 200px; border-left: 4px solid #ccc; }
      .urgency-green { border-left-color: #22c55e; }
      .urgency-amber { border-left-color: #f59e0b; }
      .urgency-red { border-left-color: #ef4444; }
      .urgency-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; margin-top: 0.5rem; }
      .urgency-badge.urgency-green { background: #dcfce7; color: #166534; }
      .urgency-badge.urgency-amber { background: #fef9c3; color: #854d0e; }
      .urgency-badge.urgency-red { background: #fee2e2; color: #991b1b; }
    </style>
  </head>
  <body>
    {@inner_content}
    <script>
      window.liveSocket = new window.PhoenixLiveView.LiveSocket("/live", window.Phoenix.Socket, {params: {_csrf_token: document.querySelector("meta[name='csrf-token']").getAttribute("content")}});
      window.liveSocket.connect();
    </script>
  </body>
</html>
