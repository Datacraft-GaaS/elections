---
export interface Crumb { label: string; href?: string; current?: boolean; }
export interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="eel-breadcrumb">
  <ol role="list" class="eel-breadcrumb__list">
    {items.map((c, i) => (
      <li class="eel-breadcrumb__item">
        {c.href && !c.current ? <a href={c.href} class="eel-breadcrumb__link">{c.label}</a> : <span aria-current={c.current ? 'page' : undefined} class="eel-breadcrumb__current">{c.label}</span>}
        {i < items.length - 1 && <span aria-hidden="true" class="eel-breadcrumb__sep">›</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .eel-breadcrumb__list { display:flex; flex-wrap:wrap; gap:0.25rem; list-style:none; margin:0; padding:0; font-size:var(--text-sm,0.875rem); }
  .eel-breadcrumb__item { display:inline-flex; align-items:center; gap:0.25rem; }
  .eel-breadcrumb__link { color:var(--color-text-link,#1a56db); text-decoration:none; padding:0.25rem 0.5rem; border-radius:var(--radius-md,4px); min-height:var(--touch-min,44px); display:inline-flex; align-items:center; }
  .eel-breadcrumb__link:hover { text-decoration:underline; background:var(--color-neutral-50,#f9fafb); }
  .eel-breadcrumb__link:focus-visible { box-shadow:var(--focus-ring); outline:none; }
  .eel-breadcrumb__current { color:var(--color-text-secondary,#4b5563); font-weight:600; padding:0.25rem 0.5rem; }
  .eel-breadcrumb__sep { color:var(--color-text-disabled,#9ca3af); }
</style>
