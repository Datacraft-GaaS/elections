---
export interface LangOption {
	code: string;
	label: string;
	nativeLabel: string;
}
export interface Props {
	locales: LangOption[];
	current: string;
}
const { locales, current } = Astro.props;
---
<div class="eel-lang" aria-label="Language selector">
	<label for="eel-lang-select" class="eel-lang__label">Language</label>
	<select id="eel-lang-select" class="eel-lang__select" aria-label="Select language">
		{locales.map(l => (
			<option value={l.code} selected={l.code === current || undefined}>
				{l.nativeLabel} ({l.label})
			</option>
		))}
	</select>
</div>
<style>
	.eel-lang { display: flex; align-items: center; gap: 0.5rem; }
	.eel-lang__label { font-size: 0.875rem; color: #6b7280; }
	.eel-lang__select { padding: 0.375rem 2rem 0.375rem 0.75rem; border: 1px solid #d1d5db; border-radius: 4px; background: #fff; font-size: 0.875rem; color: #374151; cursor: pointer; min-height: 44px; }
	.eel-lang__select:focus-visible { outline: none; border-color: #1a56db; box-shadow: var(--focus-ring, 0 0 0 3px rgba(26, 86, 219, 0.5)); outline-offset: var(--focus-offset, 2px); }
</style>
