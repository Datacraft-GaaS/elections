---
export interface Props {
	type?: 'info' | 'success' | 'warning' | 'danger';
	title?: string;
	dismissible?: boolean;
}
const { type = 'info', title, dismissible = false } = Astro.props;
const roleMap = { info: 'status', success: 'status', warning: 'alert', danger: 'alert' } as const;
---
<div
	class={`eel-alert eel-alert--${type}`}
	role={roleMap[type]}
	aria-live={type === 'danger' || type === 'warning' ? 'assertive' : 'polite'}
>
	{title && <strong class="eel-alert__title">{title}</strong>}
	<div class="eel-alert__body"><slot /></div>
	{dismissible && (
		<button class="eel-alert__close" aria-label="Dismiss alert" type="button">&times;</button>
	)}
</div>
<style>
	.eel-alert { display: flex; gap: var(--spacing-3, 0.75rem); padding: var(--spacing-4, 1rem); border-radius: var(--radius-md, 4px); border-left: 4px solid; }
	.eel-alert--info    { background: var(--color-alert-info-bg); border-color: var(--color-alert-info-border); color: var(--color-alert-info-text); }
	.eel-alert--success { background: var(--color-alert-success-bg); border-color: var(--color-alert-success-border); color: var(--color-alert-success-text); }
	.eel-alert--warning { background: var(--color-alert-warning-bg); border-color: var(--color-alert-warning-border); color: var(--color-alert-warning-text); }
	.eel-alert--danger  { background: var(--color-alert-danger-bg); border-color: var(--color-alert-danger-border); color: var(--color-alert-danger-text); }
	.eel-alert__title { font-weight: 700; margin-right: 0.5rem; }
	.eel-alert__close { margin-left: auto; background: none; border: none; cursor: pointer; font-size: 1.25rem; opacity: 0.7; min-width: 44px; min-height: 44px; display: grid; place-items: center; border-radius: 4px; }
	.eel-alert__close:focus-visible { box-shadow: var(--focus-ring, 0 0 0 3px rgba(26, 86, 219, 0.5)); outline: none; outline-offset: var(--focus-offset, 2px); }
</style>
