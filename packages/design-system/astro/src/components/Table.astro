---
export interface Props {
	caption?: string;
	striped?: boolean;
}
const { caption, striped = true } = Astro.props;
---
<div
	class="eel-table-wrapper"
	role="region"
	aria-label={caption || 'Data table'}
	tabindex="0"
>
	<table class={`eel-table${striped ? ' eel-table--striped' : ''}`}>
		{caption && <caption class="eel-table__caption">{caption}</caption>}
		<slot />
	</table>
</div>
<style>
	.eel-table-wrapper { overflow-x: auto; border-radius: 8px; border: 1px solid #e5e7eb; }
	.eel-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
	.eel-table__caption { caption-side: top; text-align: left; padding: 0.75rem 1rem; font-weight: 600; color: #374151; }
	.eel-table :global(th) { background: #f9fafb; font-weight: 600; text-align: left; padding: 0.75rem 1rem; color: #374151; border-bottom: 2px solid #e5e7eb; }
	.eel-table :global(td) { padding: 0.75rem 1rem; border-bottom: 1px solid #e5e7eb; color: #111827; }
	.eel-table--striped :global(tbody tr:nth-child(even) td) { background: #f9fafb; }
	.eel-table :global(tbody tr:hover td) { background: #eff6ff; }
</style>
