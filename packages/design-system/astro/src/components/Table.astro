---
export interface Props {
	caption?: string;
	striped?: boolean;
}
const { caption, striped = true } = Astro.props;
---
<div
	class="eel-table-wrapper"
	role="region"
	aria-label={caption || 'Data table'}
	tabindex="0"
>
	<table class={`eel-table${striped ? ' eel-table--striped' : ''}`}>
		{caption && <caption class="eel-table__caption">{caption}</caption>}
		<slot />
	</table>
</div>
<style>
	.eel-table-wrapper { overflow-x: auto; border-radius: var(--radius-lg, 8px); border: 1px solid var(--color-surface-border, #e5e7eb); }
	.eel-table-wrapper:focus-visible { box-shadow: var(--focus-ring, 0 0 0 3px rgba(26, 86, 219, 0.5)); outline: none; outline-offset: var(--focus-offset, 2px); }
	.eel-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
	.eel-table__caption { caption-side: top; text-align: left; padding: 0.75rem 1rem; font-weight: 600; color: var(--color-neutral-700, #374151); }
	.eel-table :global(th) { background: var(--color-neutral-50, #f9fafb); font-weight: 600; text-align: left; padding: 0.75rem 1rem; color: var(--color-neutral-700, #374151); border-bottom: 2px solid var(--color-surface-border, #e5e7eb); }
	.eel-table :global(td) { padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-surface-border, #e5e7eb); color: var(--color-text-primary, #111827); }
	.eel-table--striped :global(tbody tr:nth-child(even) td) { background: var(--color-neutral-50, #f9fafb); }
	.eel-table :global(tbody tr:hover td) { background: var(--color-neutral-50, #eff6ff); }
</style>
