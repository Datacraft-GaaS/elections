---
export interface Props {
  width?: string;
  height?: string;
  radius?: string;
}
const { width = '100%', height = '16px', radius = 'var(--radius-md, 4px)' } = Astro.props;
---
<div
  class="eel-skeleton"
  role="status"
  aria-label="Loading"
  aria-busy="true"
  style={`width:${width};height:${height};border-radius:${radius}`}
></div>
<style>
  .eel-skeleton {
    background: linear-gradient(90deg, var(--color-neutral-100, #f3f4f6) 25%, var(--color-neutral-200, #e5e7eb) 37%, var(--color-neutral-100, #f3f4f6) 63%);
    background-size: 400% 100%;
    animation: eel-shimmer var(--motion-slow, 300ms) var(--motion-easing, cubic-bezier(0.4,0,0.2,1)) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .eel-skeleton { animation: none; background: var(--color-neutral-200, #e5e7eb); }
  }
  @keyframes eel-shimmer { 0%{background-position: 100% 0} 100%{background-position: -100% 0} }
</style>
