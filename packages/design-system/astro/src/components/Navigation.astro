---
export interface NavItem {
	label: string;
	href: string;
	current?: boolean;
}
export interface Props {
	items: NavItem[];
	logoText?: string;
	logoHref?: string;
}
const { items, logoText = 'IEMS', logoHref = '/' } = Astro.props;
---
<nav class="eel-nav" aria-label="Main navigation">
	<div class="eel-nav__inner">
		<a href={logoHref} class="eel-nav__logo" aria-label={`${logoText} home`}>
			<span aria-hidden="true">{logoText}</span>
		</a>
		<ul class="eel-nav__list" role="list">
			{items.map(item => (
				<li>
					<a
						href={item.href}
						class={`eel-nav__link${item.current ? ' eel-nav__link--current' : ''}`}
						aria-current={item.current ? 'page' : undefined}
					>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</div>
</nav>
<style>
	.eel-nav { background: #1f2937; color: #f9fafb; }
	.eel-nav__inner { max-width: 80rem; margin: 0 auto; padding: 0 1rem; display: flex; align-items: center; gap: 2rem; height: 4rem; }
	.eel-nav__logo { font-weight: 700; font-size: 1.25rem; color: #fff; text-decoration: none; min-height: 44px; min-width: 44px; display: inline-flex; align-items: center; }
	.eel-nav__logo:focus-visible { box-shadow: var(--focus-ring, 0 0 0 3px rgba(26, 86, 219, 0.5)); outline: none; outline-offset: var(--focus-offset, 2px); }
	.eel-nav__list { display: flex; gap: var(--spacing-2, 0.5rem); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
	.eel-nav__link { display: inline-flex; align-items: center; padding: 0.5rem 0.75rem; color: #d1d5db; text-decoration: none; border-radius: 4px; font-size: 0.875rem; font-weight: 500; min-height: 44px; min-width: 44px; }
	.eel-nav__link:hover { background: #374151; color: #fff; }
	.eel-nav__link--current { background: #374151; color: #fff; }
	.eel-nav__link:focus-visible { box-shadow: var(--focus-ring, 0 0 0 3px rgba(26, 86, 219, 0.5)); outline: none; outline-offset: var(--focus-offset, 2px); }
</style>
