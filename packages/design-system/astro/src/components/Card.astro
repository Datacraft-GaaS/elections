---
export interface Props {
	title?: string;
	elevation?: 'flat' | 'sm' | 'md' | 'lg';
}
const { title, elevation = 'sm' } = Astro.props;
---
<article class={`eel-card eel-card--${elevation}`}>
	{title && <header class="eel-card__header"><h2 class="eel-card__title">{title}</h2></header>}
	<div class="eel-card__body"><slot /></div>
</article>
<style>
	.eel-card { background: var(--color-surface-bg, #fff); border-radius: var(--radius-lg, 8px); overflow: hidden; }
	.eel-card--flat { box-shadow: none; border: 1px solid var(--color-surface-border, #e5e7eb); }
	.eel-card--sm  { box-shadow: var(--shadow-sm, 0 1px 2px 0 rgb(0 0 0 / 0.05)); }
	.eel-card--md  { box-shadow: var(--shadow-md, 0 4px 6px -1px rgb(0 0 0 / 0.1)); }
	.eel-card--lg  { box-shadow: var(--shadow-lg, 0 10px 15px -3px rgb(0 0 0 / 0.1)); }
	.eel-card__header { padding: var(--spacing-4, 16px) var(--spacing-6, 24px); border-bottom: 1px solid var(--color-surface-border, #e5e7eb); }
	.eel-card__title { margin: 0; font-size: var(--text-lg, 1.125rem); font-weight: 600; color: var(--color-text-primary, #111827); line-height: var(--leading-tight, 1.25); }
	.eel-card__body { padding: var(--spacing-6, 24px); }
</style>
