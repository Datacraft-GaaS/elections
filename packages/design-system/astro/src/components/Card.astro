---
export interface Props {
	title?: string;
	elevation?: 'flat' | 'sm' | 'md' | 'lg';
}
const { title, elevation = 'sm' } = Astro.props;
---
<article class={`eel-card eel-card--${elevation}`}>
	{title && <header class="eel-card__header"><h2 class="eel-card__title">{title}</h2></header>}
	<div class="eel-card__body"><slot /></div>
</article>
<style>
	.eel-card { background: #fff; border-radius: 8px; overflow: hidden; }
	.eel-card--flat { box-shadow: none; border: 1px solid #e5e7eb; }
	.eel-card--sm  { box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); }
	.eel-card--md  { box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
	.eel-card--lg  { box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1); }
	.eel-card__header { padding: 1rem 1.5rem; border-bottom: 1px solid #e5e7eb; }
	.eel-card__title { margin: 0; font-size: 1.125rem; font-weight: 600; color: #111827; }
	.eel-card__body { padding: 1.5rem; }
</style>
