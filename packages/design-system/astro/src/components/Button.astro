---
export interface Props {
	variant?: 'primary' | 'secondary' | 'danger' | 'ghost';
	size?: 'sm' | 'md' | 'lg';
	disabled?: boolean;
	type?: 'button' | 'submit' | 'reset';
	ariaLabel?: string;
	href?: string;
}

const {
	variant = 'primary',
	size = 'md',
	disabled = false,
	type = 'button',
	ariaLabel,
	href,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
	class={`eel-btn eel-btn--${variant} eel-btn--${size}`}
	{type}
	disabled={disabled || undefined}
	aria-label={ariaLabel}
	href={href}
	aria-disabled={disabled ? 'true' : undefined}
>
	<slot />
</Tag>

<style>
	.eel-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-weight: 600;
		border-radius: 4px;
		border: 2px solid transparent;
		cursor: pointer;
		text-decoration: none;
		min-height: 44px;
		min-width: 44px;
		transition: background-color var(--motion-normal, 200ms) var(--motion-easing, cubic-bezier(0.4, 0, 0.2, 1)),
			border-color var(--motion-normal, 200ms) var(--motion-easing, cubic-bezier(0.4, 0, 0.2, 1)),
			color var(--motion-normal, 200ms) var(--motion-easing, cubic-bezier(0.4, 0, 0.2, 1)),
			box-shadow var(--motion-fast, 100ms) var(--motion-easing, cubic-bezier(0.4, 0, 0.2, 1));
	}
	.eel-btn:focus-visible {
		outline: none;
		box-shadow: var(--focus-ring, 0 0 0 3px rgba(26, 86, 219, 0.5));
		outline-offset: var(--focus-offset, 2px);
	}
	@media (prefers-reduced-motion: reduce) {
		.eel-btn { transition-duration: 0.01ms !important; }
	}
	.eel-btn--sm { padding: 0.25rem 0.75rem; font-size: 0.875rem; min-height: 44px; }
	.eel-btn--md { padding: 0.5rem 1rem; font-size: 1rem; min-height: 44px; }
	.eel-btn--lg { padding: 0.75rem 1.5rem; font-size: 1.125rem; min-height: 44px; }
	.eel-btn--primary { background: var(--color-brand-primary); color: var(--color-text-inverse); border-color: var(--color-brand-primary); }
	.eel-btn--primary:hover:not(:disabled) { background: var(--color-brand-primary-hover); border-color: var(--color-brand-primary-hover); }
	.eel-btn--secondary { background: var(--color-neutral-100); color: var(--color-neutral-700); border-color: var(--color-neutral-300); }
	.eel-btn--secondary:hover:not(:disabled) { background: var(--color-neutral-200); }
	.eel-btn--danger { background: var(--color-semantic-danger); color: var(--color-text-inverse); border-color: var(--color-semantic-danger); }
	.eel-btn--danger:hover:not(:disabled) { background: var(--color-semantic-danger-hover); }
	.eel-btn--ghost { background: transparent; color: var(--color-brand-primary); border-color: transparent; }
	.eel-btn--ghost:hover:not(:disabled) { background: var(--color-alert-info-bg); }
	.eel-btn:disabled,
	.eel-btn[aria-disabled='true'] {
		opacity: 0.5;
		cursor: not-allowed;
		pointer-events: none;
	}
</style>
