{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Source module: M01-BVR. Kafka topic: eel.bvr.voter.v1 (operational).",
  "title": "bvr.voter.enrolment_accepted.v1",
  "description": "A voter enrolment has been accepted into the biometric voter register.",
  "x-eel-topic": "eel.bvr.voter.v1",
  "x-eel-owner": "platform-eng",
  "x-eel-slack-channel": "#eel-events",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "data",
    "eel_hlc",
    "eel_correlation_id",
    "eel_causation_id",
    "eel_producer_key_id",
    "eel_signature",
    "eel_election_id",
    "eel_data_class"
  ],
  "additionalProperties": true,
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0",
      "description": "CloudEvents specification version."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7 event identifier."
    },
    "type": {
      "type": "string",
      "const": "eel.bvr.voter.enrolment_accepted.v1",
      "description": "Fully-qualified eel event type string."
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "SPIFFE SVID of the producing service."
    },
    "subject": {
      "type": "string",
      "description": "Aggregate root path for this event."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC event timestamp."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URI of this schema."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voter_id",
        "kit_serial",
        "station_code",
        "enrolment_batch_id",
        "accepted_at",
        "iprs_verified",
        "modalities_captured"
      ],
      "properties": {
        "voter_id": {
          "type": "string",
          "description": "UUIDv7 voter pseudonym; no raw PII stored here.",
          "x-eel-data-class": "A",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kit_serial": {
          "type": "string",
          "description": "Enrolment kit serial number.",
          "x-eel-data-class": "C"
        },
        "station_code": {
          "type": "string",
          "description": "Enrolment station code.",
          "x-eel-data-class": "C"
        },
        "enrolment_batch_id": {
          "type": "string",
          "description": "Batch identifier for bulk import reconciliation.",
          "x-eel-data-class": "C",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "accepted_at": {
          "type": "string",
          "description": "ISO 8601 UTC acceptance timestamp.",
          "x-eel-data-class": "D",
          "format": "date-time"
        },
        "iprs_verified": {
          "type": "boolean",
          "x-eel-data-class": "D",
          "description": "Whether identity was verified against IPRS."
        },
        "modalities_captured": {
          "type": "array",
          "x-eel-data-class": "D",
          "items": {
            "type": "string",
            "enum": [
              "fingerprint",
              "iris",
              "face"
            ]
          },
          "description": "Biometric modalities captured during enrolment."
        }
      }
    },
    "eel_hlc": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Hybrid Logical Clock timestamp (wallclock.counter.node)."
    },
    "eel_correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Trace-level correlation identifier."
    },
    "eel_causation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "ID of the event that caused this one."
    },
    "eel_producer_key_id": {
      "type": "string",
      "description": "Key fingerprint used to sign this event (e.g. spiffe-svid:fp)."
    },
    "eel_signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]+=*$",
      "description": "Ed25519 signature over canonical event bytes."
    },
    "eel_election_id": {
      "type": "string",
      "description": "Election identifier (e.g. 2027-general)."
    },
    "eel_data_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Highest data classification present in this event."
    },
    "eel_prev_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of prior event; optional for non-event-source topics."
    }
  }
}