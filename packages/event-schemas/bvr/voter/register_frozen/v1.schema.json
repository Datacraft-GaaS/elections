{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Source module: M01-BVR. Kafka topic: eel.bvr.voter.v1 (event-source).",
  "title": "bvr.voter.register_frozen.v1",
  "description": "The voter register has been frozen for an election, with Merkle root and escrow confirmation.",
  "x-eel-topic": "eel.bvr.voter.v1",
  "x-eel-owner": "platform-eng",
  "x-eel-slack-channel": "#eel-events",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "data",
    "eel_hlc",
    "eel_correlation_id",
    "eel_causation_id",
    "eel_producer_key_id",
    "eel_signature",
    "eel_election_id",
    "eel_data_class",
    "eel_stream_id",
    "eel_seq",
    "eel_prev_hash"
  ],
  "additionalProperties": true,
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0",
      "description": "CloudEvents specification version."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7 event identifier."
    },
    "type": {
      "type": "string",
      "const": "eel.bvr.voter.register_frozen.v1",
      "description": "Fully-qualified eel event type string."
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "SPIFFE SVID of the producing service."
    },
    "subject": {
      "type": "string",
      "description": "Aggregate root path for this event."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC event timestamp."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URI of this schema."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election_id",
        "scope",
        "frozen_at",
        "frozen_by",
        "voter_count",
        "merkle_root",
        "escrow_confirmed"
      ],
      "properties": {
        "election_id": {
          "type": "string",
          "description": "Election for which the register is frozen.",
          "x-eel-data-class": "C"
        },
        "scope": {
          "type": "string",
          "description": "Geographic scope of this freeze (national, regional, etc.).",
          "x-eel-data-class": "C"
        },
        "frozen_at": {
          "type": "string",
          "description": "ISO 8601 UTC freeze timestamp.",
          "x-eel-data-class": "D",
          "format": "date-time"
        },
        "frozen_by": {
          "type": "string",
          "description": "Officer ID authorizing the freeze.",
          "x-eel-data-class": "C"
        },
        "voter_count": {
          "type": "integer",
          "x-eel-data-class": "C",
          "minimum": 0,
          "description": "Number of registered voters at freeze time."
        },
        "merkle_root": {
          "type": "string",
          "description": "SHA-256 Merkle root over the frozen register.",
          "x-eel-data-class": "C",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "escrow_confirmed": {
          "type": "boolean",
          "x-eel-data-class": "D",
          "description": "True if the register has been confirmed in escrow storage."
        }
      }
    },
    "eel_hlc": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Hybrid Logical Clock timestamp (wallclock.counter.node)."
    },
    "eel_correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Trace-level correlation identifier."
    },
    "eel_causation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "ID of the event that caused this one."
    },
    "eel_producer_key_id": {
      "type": "string",
      "description": "Key fingerprint used to sign this event (e.g. spiffe-svid:fp)."
    },
    "eel_signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]+=*$",
      "description": "Ed25519 signature over canonical event bytes."
    },
    "eel_election_id": {
      "type": "string",
      "description": "Election identifier (e.g. 2027-general)."
    },
    "eel_data_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Highest data classification present in this event."
    },
    "eel_stream_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Aggregate stream identifier for ordered event log."
    },
    "eel_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotone sequence number within the stream."
    },
    "eel_prev_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 hash of the previous event in this stream."
    }
  }
}