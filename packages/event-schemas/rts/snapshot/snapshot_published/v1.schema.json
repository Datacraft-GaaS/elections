{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Source module: M10-RTS. Kafka topic: eel.rts.snapshot.v1 (event-source).",
  "title": "rts.snapshot.snapshot_published.v1",
  "description": "A tally snapshot has been published for a given scope, with Merkle root and HSM signature.",
  "x-eel-topic": "eel.rts.snapshot.v1",
  "x-eel-owner": "platform-eng",
  "x-eel-slack-channel": "#eel-events",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "data",
    "eel_hlc",
    "eel_correlation_id",
    "eel_causation_id",
    "eel_producer_key_id",
    "eel_signature",
    "eel_election_id",
    "eel_data_class",
    "eel_stream_id",
    "eel_seq",
    "eel_prev_hash"
  ],
  "additionalProperties": true,
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0",
      "description": "CloudEvents specification version."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7 event identifier."
    },
    "type": {
      "type": "string",
      "const": "eel.rts.snapshot.snapshot_published.v1",
      "description": "Fully-qualified eel event type string."
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "SPIFFE SVID of the producing service."
    },
    "subject": {
      "type": "string",
      "description": "Aggregate root path for this event."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC event timestamp."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URI of this schema."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "scope",
        "scope_code",
        "election_id",
        "position_code",
        "totals_json_ref",
        "merkle_root",
        "published_at",
        "hsm_sig",
        "publication_seq"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "description": "UUIDv7 snapshot identifier.",
          "x-eel-data-class": "D",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "scope": {
          "type": "string",
          "x-eel-data-class": "C",
          "enum": [
            "national",
            "regional",
            "constituency",
            "station"
          ],
          "description": "Geographic scope of this snapshot."
        },
        "scope_code": {
          "type": "string",
          "description": "Code identifying the specific scope entity.",
          "x-eel-data-class": "C"
        },
        "election_id": {
          "type": "string",
          "description": "Election identifier.",
          "x-eel-data-class": "C"
        },
        "position_code": {
          "type": "string",
          "description": "Electoral position code.",
          "x-eel-data-class": "C"
        },
        "totals_json_ref": {
          "type": "string",
          "description": "MinIO object key for the totals JSON document.",
          "x-eel-data-class": "C"
        },
        "merkle_root": {
          "type": "string",
          "description": "SHA-256 Merkle root over the tally leaves.",
          "x-eel-data-class": "C",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "published_at": {
          "type": "string",
          "description": "ISO 8601 UTC publication timestamp.",
          "x-eel-data-class": "D",
          "format": "date-time"
        },
        "hsm_sig": {
          "type": "string",
          "description": "HSM Ed25519 signature over (merkle_root + published_at).",
          "x-eel-data-class": "C",
          "pattern": "^ed25519:[A-Za-z0-9+/]+=*$"
        },
        "publication_seq": {
          "type": "integer",
          "x-eel-data-class": "D",
          "minimum": 1,
          "description": "Monotone publication sequence number."
        }
      }
    },
    "eel_hlc": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Hybrid Logical Clock timestamp (wallclock.counter.node)."
    },
    "eel_correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Trace-level correlation identifier."
    },
    "eel_causation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "ID of the event that caused this one."
    },
    "eel_producer_key_id": {
      "type": "string",
      "description": "Key fingerprint used to sign this event (e.g. spiffe-svid:fp)."
    },
    "eel_signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]+=*$",
      "description": "Ed25519 signature over canonical event bytes."
    },
    "eel_election_id": {
      "type": "string",
      "description": "Election identifier (e.g. 2027-general)."
    },
    "eel_data_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Highest data classification present in this event."
    },
    "eel_stream_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Aggregate stream identifier for ordered event log."
    },
    "eel_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotone sequence number within the stream."
    },
    "eel_prev_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 hash of the previous event in this stream."
    }
  }
}