{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Source module: M10-RTS. Kafka topic: eel.rts.form.v1 (event-source).",
  "title": "rts.form.form_captured.v1",
  "description": "A Form 34A scan has been captured by a polling kit and ingested into the RTS pipeline.",
  "x-eel-topic": "eel.rts.form.v1",
  "x-eel-owner": "platform-eng",
  "x-eel-slack-channel": "#eel-events",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "data",
    "eel_hlc",
    "eel_correlation_id",
    "eel_causation_id",
    "eel_producer_key_id",
    "eel_signature",
    "eel_election_id",
    "eel_data_class",
    "eel_stream_id",
    "eel_seq",
    "eel_prev_hash"
  ],
  "additionalProperties": true,
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0",
      "description": "CloudEvents specification version."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7 event identifier."
    },
    "type": {
      "type": "string",
      "const": "eel.rts.form.form_captured.v1",
      "description": "Fully-qualified eel event type string."
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "SPIFFE SVID of the producing service."
    },
    "subject": {
      "type": "string",
      "description": "Aggregate root path for this event."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC event timestamp."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URI of this schema."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_id",
        "station_code",
        "election_id",
        "position_code",
        "raw_scan_ref",
        "image_hash",
        "quality_score",
        "kit_serial",
        "kit_sig",
        "capture_at",
        "channel"
      ],
      "properties": {
        "form_id": {
          "type": "string",
          "description": "UUIDv7 identifier for this form instance.",
          "x-eel-data-class": "C",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "station_code": {
          "type": "string",
          "description": "Polling station code.",
          "x-eel-data-class": "C"
        },
        "election_id": {
          "type": "string",
          "description": "Election this form belongs to.",
          "x-eel-data-class": "C"
        },
        "position_code": {
          "type": "string",
          "description": "Electoral position code on this form.",
          "x-eel-data-class": "C"
        },
        "raw_scan_ref": {
          "type": "string",
          "description": "MinIO object key for the raw scanned image.",
          "x-eel-data-class": "C"
        },
        "image_hash": {
          "type": "string",
          "description": "SHA-256 digest of the raw scan file.",
          "x-eel-data-class": "C",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "quality_score": {
          "type": "number",
          "x-eel-data-class": "D",
          "minimum": 0,
          "maximum": 100,
          "description": "ICR quality score 0-100."
        },
        "kit_serial": {
          "type": "string",
          "description": "Hardware serial number of the capturing kit.",
          "x-eel-data-class": "C"
        },
        "kit_sig": {
          "type": "string",
          "description": "Ed25519 signature from kit over image_hash.",
          "x-eel-data-class": "C",
          "pattern": "^ed25519:[A-Za-z0-9+/]+=*$"
        },
        "capture_at": {
          "type": "string",
          "description": "ISO 8601 UTC timestamp of capture.",
          "x-eel-data-class": "C",
          "format": "date-time"
        },
        "channel": {
          "type": "string",
          "x-eel-data-class": "D",
          "enum": [
            "primary",
            "sms_fallback",
            "ussd_fallback"
          ],
          "description": "Submission channel used."
        }
      }
    },
    "eel_hlc": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Hybrid Logical Clock timestamp (wallclock.counter.node)."
    },
    "eel_correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Trace-level correlation identifier."
    },
    "eel_causation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "ID of the event that caused this one."
    },
    "eel_producer_key_id": {
      "type": "string",
      "description": "Key fingerprint used to sign this event (e.g. spiffe-svid:fp)."
    },
    "eel_signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]+=*$",
      "description": "Ed25519 signature over canonical event bytes."
    },
    "eel_election_id": {
      "type": "string",
      "description": "Election identifier (e.g. 2027-general)."
    },
    "eel_data_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Highest data classification present in this event."
    },
    "eel_stream_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Aggregate stream identifier for ordered event log."
    },
    "eel_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotone sequence number within the stream."
    },
    "eel_prev_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 hash of the previous event in this stream."
    }
  }
}