{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Source module: M02-BVI. Kafka topic: eel.bvi.turnout.v1 (analytics).",
  "title": "bvi.turnout.turnout_rollup_updated.v1",
  "description": "A voter turnout rollup has been computed for a scope and time window (analytics).",
  "x-eel-topic": "eel.bvi.turnout.v1",
  "x-eel-owner": "platform-eng",
  "x-eel-slack-channel": "#eel-events",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "data",
    "eel_hlc",
    "eel_correlation_id",
    "eel_causation_id",
    "eel_producer_key_id",
    "eel_signature",
    "eel_election_id",
    "eel_data_class"
  ],
  "additionalProperties": true,
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0",
      "description": "CloudEvents specification version."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7 event identifier."
    },
    "type": {
      "type": "string",
      "const": "eel.bvi.turnout.turnout_rollup_updated.v1",
      "description": "Fully-qualified eel event type string."
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "SPIFFE SVID of the producing service."
    },
    "subject": {
      "type": "string",
      "description": "Aggregate root path for this event."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC event timestamp."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URI of this schema."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollup_id",
        "scope",
        "scope_code",
        "authenticated_count",
        "updated_at",
        "computation_window_s"
      ],
      "properties": {
        "rollup_id": {
          "type": "string",
          "description": "UUIDv7 rollup record identifier.",
          "x-eel-data-class": "D",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "scope": {
          "type": "string",
          "description": "Geographic scope (national, regional, constituency, station).",
          "x-eel-data-class": "D"
        },
        "scope_code": {
          "type": "string",
          "description": "Code identifying the specific scope entity.",
          "x-eel-data-class": "D"
        },
        "authenticated_count": {
          "type": "integer",
          "x-eel-data-class": "D",
          "minimum": 0,
          "description": "Number of voters authenticated in this window."
        },
        "updated_at": {
          "type": "string",
          "description": "ISO 8601 UTC timestamp of this rollup.",
          "x-eel-data-class": "D",
          "format": "date-time"
        },
        "computation_window_s": {
          "type": "integer",
          "x-eel-data-class": "D",
          "minimum": 1,
          "description": "Aggregation window in seconds."
        }
      }
    },
    "eel_hlc": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Hybrid Logical Clock timestamp (wallclock.counter.node)."
    },
    "eel_correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Trace-level correlation identifier."
    },
    "eel_causation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "ID of the event that caused this one."
    },
    "eel_producer_key_id": {
      "type": "string",
      "description": "Key fingerprint used to sign this event (e.g. spiffe-svid:fp)."
    },
    "eel_signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]+=*$",
      "description": "Ed25519 signature over canonical event bytes."
    },
    "eel_election_id": {
      "type": "string",
      "description": "Election identifier (e.g. 2027-general)."
    },
    "eel_data_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Highest data classification present in this event."
    },
    "eel_prev_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of prior event; optional for non-event-source topics."
    }
  }
}