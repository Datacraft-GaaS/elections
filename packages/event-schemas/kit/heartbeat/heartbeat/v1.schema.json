{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Source module: M11-Kit. Kafka topic: eel.kit.heartbeat.v1 (analytics).",
  "title": "kit.heartbeat.heartbeat.v1",
  "description": "Periodic health telemetry from a polling kit (analytics; high-volume, low-latency).",
  "x-eel-topic": "eel.kit.heartbeat.v1",
  "x-eel-owner": "platform-eng",
  "x-eel-slack-channel": "#eel-events",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "data",
    "eel_hlc",
    "eel_correlation_id",
    "eel_causation_id",
    "eel_producer_key_id",
    "eel_signature",
    "eel_election_id",
    "eel_data_class"
  ],
  "additionalProperties": true,
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0",
      "description": "CloudEvents specification version."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7 event identifier."
    },
    "type": {
      "type": "string",
      "const": "eel.kit.heartbeat.heartbeat.v1",
      "description": "Fully-qualified eel event type string."
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "SPIFFE SVID of the producing service."
    },
    "subject": {
      "type": "string",
      "description": "Aggregate root path for this event."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC event timestamp."
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URI of this schema."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kit_serial",
        "battery_pct",
        "storage_free_mb",
        "connectivity",
        "firmware_version",
        "uptime_s",
        "ts"
      ],
      "properties": {
        "kit_serial": {
          "type": "string",
          "description": "Hardware serial of the kit sending heartbeat.",
          "x-eel-data-class": "C"
        },
        "station_code": {
          "type": [
            "string",
            "null"
          ],
          "x-eel-data-class": "C",
          "description": "Assigned station code; null if kit not yet deployed."
        },
        "battery_pct": {
          "type": "number",
          "x-eel-data-class": "D",
          "minimum": 0,
          "maximum": 100,
          "description": "Battery charge percentage."
        },
        "storage_free_mb": {
          "type": "number",
          "x-eel-data-class": "D",
          "minimum": 0,
          "description": "Free storage in megabytes."
        },
        "connectivity": {
          "type": "string",
          "x-eel-data-class": "D",
          "enum": [
            "wifi",
            "4g",
            "3g",
            "2g",
            "offline"
          ],
          "description": "Current network connectivity type."
        },
        "firmware_version": {
          "type": "string",
          "description": "Installed firmware version string.",
          "x-eel-data-class": "D"
        },
        "uptime_s": {
          "type": "integer",
          "x-eel-data-class": "D",
          "minimum": 0,
          "description": "Kit uptime in seconds since last boot."
        },
        "ts": {
          "type": "string",
          "description": "ISO 8601 UTC timestamp of this heartbeat.",
          "x-eel-data-class": "D",
          "format": "date-time"
        },
        "gps_fix": {
          "type": [
            "object",
            "null"
          ],
          "x-eel-data-class": "D",
          "description": "GPS fix at time of event; null when unavailable.",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "accuracy": {
              "type": "number"
            }
          },
          "required": [
            "lat",
            "lon",
            "accuracy"
          ],
          "additionalProperties": false
        }
      }
    },
    "eel_hlc": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Hybrid Logical Clock timestamp (wallclock.counter.node)."
    },
    "eel_correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Trace-level correlation identifier."
    },
    "eel_causation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "ID of the event that caused this one."
    },
    "eel_producer_key_id": {
      "type": "string",
      "description": "Key fingerprint used to sign this event (e.g. spiffe-svid:fp)."
    },
    "eel_signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]+=*$",
      "description": "Ed25519 signature over canonical event bytes."
    },
    "eel_election_id": {
      "type": "string",
      "description": "Election identifier (e.g. 2027-general)."
    },
    "eel_data_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Highest data classification present in this event."
    },
    "eel_prev_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of prior event; optional for non-event-source topics."
    }
  }
}