{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eel.local/ai_platform/anomaly/anomaly_detected/v1.json",
  "title": "eel.ai_platform.anomaly_detected.v1",
  "type": "object",
  "required": ["specversion","id","type","source","subject","time","datacontenttype","data","eel_stream_id","eel_seq","eel_hlc","eel_prev_hash","eel_correlation_id","eel_causation_id","eel_producer_key_id","eel_signature","eel_election_id","eel_data_class"],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid", "description": "UUIDv7 event identifier"},
    "type": {"const": "eel.ai_platform.anomaly_detected.v1"},
    "source": {"const": "spiffe://eel.local/service/ai-platform-svc"},
    "subject": {"type": "string", "description": "Alert identifier"},
    "time": {"type": "string", "format": "date-time"},
    "datacontenttype": {"const": "application/json"},
    "dataschema": {"const": "https://schemas.eel.local/ai_platform/anomaly/anomaly_detected/v1.json"},
    "data": {
      "type": "object",
      "required": ["alert_id","alert_type","severity","entity_ref","explanation","detected_at"],
      "properties": {
        "alert_id": {"type": "string", "format": "uuid"},
        "alert_type": {"type": "string", "enum": ["turnout_spike","result_outlier","queue_anomaly","network_intrusion","media_disinformation","identity_fraud","device_tamper_cluster"]},
        "severity": {"type": "string", "enum": ["info","warning","critical"]},
        "entity_ref": {"type": "string", "description": "Reference to flagged entity e.g. station:STA-001 or candidate:uuid"},
        "explanation": {"type": "string", "maxLength": 1000, "description": "Human-readable explanation of anomaly"},
        "detected_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "eel_stream_id": {"type": "string", "format": "uuid", "description": "Event stream identifier"},
    "eel_seq": {"type": "integer", "minimum": 0, "description": "Monotonic sequence number within stream"},
    "eel_hlc": {"type": "string", "description": "Hybrid logical clock timestamp"},
    "eel_prev_hash": {"type": "string", "description": "sha256 hash of previous event in stream"},
    "eel_correlation_id": {"type": "string", "format": "uuid", "description": "Correlation identifier for tracing"},
    "eel_causation_id": {"type": ["string", "null"], "format": "uuid", "description": "Causation event identifier"},
    "eel_producer_key_id": {"type": "string", "description": "Key identifier used for signature"},
    "eel_signature": {"type": "string", "description": "Ed25519 signature base64url"},
    "eel_election_id": {"type": "string", "description": "Election identifier"},
    "eel_data_class": {"const": "D", "description": "Data classification level"}
  },
  "additionalProperties": false
}
