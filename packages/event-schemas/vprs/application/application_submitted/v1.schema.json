{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eel.local/vprs/application/application_submitted/v1.json",
  "title": "eel.vprs.application_submitted.v1",
  "type": "object",
  "required": ["specversion","id","type","source","subject","time","datacontenttype","data","eel_stream_id","eel_seq","eel_hlc","eel_prev_hash","eel_correlation_id","eel_causation_id","eel_producer_key_id","eel_signature","eel_election_id","eel_data_class"],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid", "description": "UUIDv7 event identifier"},
    "type": {"const": "eel.vprs.application_submitted.v1"},
    "source": {"const": "spiffe://eel.local/service/vprs-svc"},
    "subject": {"type": "string", "description": "VPRSApplication identifier"},
    "time": {"type": "string", "format": "date-time"},
    "datacontenttype": {"const": "application/json"},
    "dataschema": {"const": "https://schemas.eel.local/vprs/application/application_submitted/v1.json"},
    "data": {
      "type": "object",
      "required": ["app_id","id_number_hash","biographic_hash","status","qr_token_hash","expires_at"],
      "properties": {
        "app_id": {"type": "string", "format": "uuid", "description": "Application UUID"},
        "id_number_hash": {"type": "string", "description": "SHA-256 of national ID number - data class B PII"},
        "biographic_hash": {"type": "string", "description": "SHA-256 of biographic fields - data class B PII"},
        "status": {"type": "string", "enum": ["pending","accepted","rejected","cancelled"], "description": "Application status"},
        "qr_token_hash": {"type": "string", "description": "SHA-256 of QR token for handoff - data class B"},
        "expires_at": {"type": "string", "format": "date-time", "description": "Token expiry timestamp"}
      },
      "additionalProperties": false
    },
    "eel_stream_id": {"type": "string", "format": "uuid", "description": "Event stream identifier"},
    "eel_seq": {"type": "integer", "minimum": 0, "description": "Monotonic sequence number within stream"},
    "eel_hlc": {"type": "string", "description": "Hybrid logical clock timestamp"},
    "eel_prev_hash": {"type": "string", "description": "sha256 hash of previous event in stream"},
    "eel_correlation_id": {"type": "string", "format": "uuid", "description": "Correlation identifier for tracing"},
    "eel_causation_id": {"type": ["string", "null"], "format": "uuid", "description": "Causation event identifier"},
    "eel_producer_key_id": {"type": "string", "description": "Key identifier used for signature"},
    "eel_signature": {"type": "string", "description": "Ed25519 signature base64url"},
    "eel_election_id": {"type": "string", "description": "Election identifier"},
    "eel_data_class": {"const": "B", "description": "Data classification level"}
  },
  "additionalProperties": false
}
