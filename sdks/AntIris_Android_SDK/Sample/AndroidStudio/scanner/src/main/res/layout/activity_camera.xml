<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/topLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"

    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/midLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/GRAY"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/USBCameraTextureViewLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="horizontal">

            <com.antiris.AntUSBCamera.widget.USBCameraTextureView
                android:id="@+id/camera_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.antiris.AntUSBCamera.widget.CustomProgressCircle
                android:id="@+id/enroll_progress"
                baseColor="#00ffffff"
                color="#ff00e200"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:alpha="0.5" />

            <com.antiris.AntUSBCamera.widget.Draw
                android:id="@+id/oval"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:scaleType="fitXY" />


        </RelativeLayout>
    </LinearLayout>

    <LinearLayout

        android:layout_width="match_parent"
        android:id="@+id/rightLayout"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_checkBox"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:id="@+id/ck_camera"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/text_camera_connect"
                tools:ignore="NestedWeights" />

            <CheckBox
             android:id="@+id/view_mirror"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:checked="false"
             android:clickable="true"
             android:text="@string/mirror" />

            <CheckBox
                android:id="@+id/view_flip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:clickable="true"
                android:text="@string/flip" />

            <ImageView
                android:id="@+id/more"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/more"/>
        </LinearLayout>



        <LinearLayout
            android:id="@+id/eye_num"
            android:orientation="horizontal"
            android:layout_below="@+id/ll_checkBox"
            android:layout_width="match_parent"
            android:visibility="visible"
            android:layout_marginTop="0dp"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_gravity="center"
                android:layout_height="wrap_content">
                <com.antiris.AntUSBCamera.widget.MultipleLineRadioGroup
                    android:id="@+id/eyeNumRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/left_eye"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="onRadioButtonClicked"
                        android:checked="false"
                        android:text="@string/left_eye" />

                    <RadioButton
                        android:id="@+id/right_eye"
                        android:layout_width="wrap_content"
                        android:onClick="onRadioButtonClicked"
                        android:layout_height="wrap_content"
                        android:text= "@string/right_eye"/>
                    <RadioButton
                        android:id="@+id/two_eyes"
                        android:layout_width="wrap_content"
                        android:onClick="onRadioButtonClicked"
                        android:layout_height="wrap_content"
                        android:text= "@string/two_eyes"/>
                </com.antiris.AntUSBCamera.widget.MultipleLineRadioGroup>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/irex_type"
            android:orientation="horizontal"
            android:layout_below="@+id/eye_num"
            android:layout_width="match_parent"
            android:visibility="visible"
            android:layout_marginTop="8dp"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_weight="1.2"
                android:layout_width="0dp"
                android:layout_gravity="center"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:id="@+id/irex_type_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/k1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="K1" />

                    <RadioButton
                        android:id="@+id/k2"
                        android:checked="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text= "K2"/>
                    <RadioButton
                        android:id="@+id/k3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="K3" />

                    <RadioButton
                        android:id="@+id/k7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text= "K7"/>
                </RadioGroup>
            </LinearLayout>

        </LinearLayout>



        <LinearLayout
            android:layout_below="@+id/ll_checkBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/hint_white_led"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/white_LED"
                android:textColor="@color/black"
                android:textSize="12dp"/>

            <SeekBar
                android:id="@+id/seekbar_white_led"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <TextView
            android:id="@+id/hintTv"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@id/eye_num"
            android:gravity="center"
            android:textColor="@color/BLUE"
            android:textSize="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20.0dip"
            android:id="@+id/ll_stream"
            android:layout_below="@+id/hintTv"
            android:orientation="horizontal"
            android:weightSum="1">

            <Button
                android:id="@+id/stopstream"
                android:textAllCaps="false"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp"
                android:textColor="@color/white"
                android:background="@drawable/button_style"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="0.5"
                android:text="@string/stop_stream"/>
        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip"
            android:layout_marginTop="10.0dip"
            android:orientation="horizontal">

            <Button
                android:id="@+id/enrollBtn"
                android:textAllCaps="false"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:textColor="@color/white"
                android:background="@drawable/button_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_enroll"/>

            <Button
                android:id="@+id/verifyBtn"
                android:textAllCaps="false"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:textColor="@color/white"
                android:background="@drawable/button_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_verify"/>
        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_irex_capture"
            android:layout_marginTop="10.0dip"
            android:orientation="horizontal">

            <Button
                android:id="@+id/irex_capture"
                android:textAllCaps="false"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:textColor="@color/white"
                android:background="@drawable/button_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/irex_capture"/>

            <Button
                android:id="@+id/clear"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:textColor="@color/white"
                android:background="@drawable/button_style"
                android:textAllCaps="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_cancel"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_irex_capture"
            android:layout_gravity="center"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/ck_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:textSize="11dp"
                android:checked="false"
                android:text="@string/manual"
                android:layout_weight="1"
                tools:ignore="NestedWeights" />
            <TextView
                android:id="@+id/blank"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_k7"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp"
            android:layout_width="match_parent"

            android:layout_weight="1"
            android:layout_height="0dp">

            <ImageView
                android:id="@+id/k7imageLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/k7imageRight"
                android:layout_width="0dp"
                android:layout_marginStart="2dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"

                android:scaleType="fitCenter" />

        </LinearLayout>

    </LinearLayout>


</LinearLayout>




