{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eel.internal/schemas/hash-manifest/v1",
  "title": "EelHashManifest",
  "type": "object",
  "required": ["schema_version", "bundle_id", "created_at", "tally_root", "artefacts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1"],
      "description": "Manifest schema version. Must be '1'."
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique bundle identifier."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC creation timestamp (ISO 8601)."
    },
    "tally_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "BLAKE3 Merkle root of the replayed event stream."
    },
    "artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Artefact"
      }
    }
  },
  "$defs": {
    "Artefact": {
      "type": "object",
      "required": ["name", "kind", "sha256", "source_ref"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["image", "binary", "library", "policy", "schema"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of artefact content (lowercase hex, no prefix)."
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Git commit SHA."
        },
        "build_recipe": {
          "type": "string",
          "description": "Nix attribute path."
        },
        "sbom_ref": {
          "type": "string",
          "description": "Bundle-relative path to SBOM JSON."
        },
        "cosign_sig_ref": {
          "type": "string",
          "description": "Bundle-relative path to cosign detached signature."
        }
      }
    }
  }
}
