{
  "__inputs": [
    {
      "name": "datasource",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [],
  "title": "ABIS Attestation",
  "description": "TDX/SEV report verifications, failure reason breakdown, nonce replay attempts.",
  "uid": "eel-abis-attestation",
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "row", "title": "Verification Rates",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "id": 2, "type": "timeseries", "title": "Attestation Verifications/s",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum by (report_type) (rate(eel_abis_attest_verify_total[1m]))",
          "legendFormat": "{{report_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3, "type": "timeseries", "title": "Attestation Failures/min",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(eel_abis_attest_failure_total[1m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4, "type": "timeseries", "title": "Nonce Replay Attempts/min",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(eel_abis_attest_nonce_replay_total[1m])) * 60",
          "legendFormat": "replays/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5, "type": "row", "title": "Failure Reason Breakdown",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "collapsed": false
    },
    {
      "id": 6, "type": "piechart", "title": "Failure Reasons (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "sum by (reason) (increase(eel_abis_attest_failure_total[24h]))",
          "legendFormat": "{{reason}}",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 7, "type": "stat", "title": "Stale Nonces Rejected (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "sum(increase(eel_abis_attest_stale_nonce_total[24h]))",
          "legendFormat": "stale nonces"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
